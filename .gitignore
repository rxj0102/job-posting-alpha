# Processed data (re-derivable)
data/processed/*.csv

# Outputs (re-generatable)
outputs/*.png
outputs/*.svg
outputs/*.pdf
outputs/*.csv

# Credentials / secrets
.env
*.env
secrets.json
api_keys.txt

